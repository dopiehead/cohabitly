<?php

// src/Event/PropertyCreatedEvent.php
namespace App\Event;

use App\Entity\PropertyList;
use Symfony\Contracts\EventDispatcher\Event;

class PropertyCreatedEvent extends Event
{
    public const NAME = 'property.created';

    private PropertyList $property;

    public function __construct(PropertyList $property)
    {
        $this->property = $property;
    }

    public function getProperty(): PropertyList
    {
        return $this->property;
    }
}